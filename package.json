{
  "name": "social-autoposter",
  "version": "1.0.0",
  "description": "Gemini-generated posts, scheduled in Firestore, published to Instagram",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "generate": "node src/generate.js",
    "generate:dry": "node src/generate.js --dry --days 2",
    "publish": "node src/publish.js",
    "publish:dry": "node src/publish.js --dry",
    "refresh-token": "node src/refreshToken.js",
    "dev": "node src/scheduler.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.7.0",
    "node-cron": "^3.0.3",
    "sharp": "^0.33.5"
  }
}
