# ---------- Gemini ----------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# "card" = free text-on-gradient image made locally (always works)
# "gemini" = try Gemini image generation first, fall back to card if it fails
IMAGE_MODE=card

# ---------- Firebase (Spark plan, Firestore only) ----------
# Local: path to the service account JSON you downloaded
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# GitHub Actions: base64 of that JSON (see README)
FIREBASE_SERVICE_ACCOUNT_B64=

# ---------- Cloudinary (free image hosting; Instagram needs a public image URL) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Instagram (Instagram API with Instagram Login) ----------
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# ---------- Brand / schedule ----------
BRAND_NAME=My Brand
NICHE=productivity tips for students
TONE=friendly, motivating, concise
AUDIENCE=college students in India
TZ_OFFSET_MIN=330
POST_HOURS=9,19
DAYS_AHEAD=3
DRY_RUN=false
